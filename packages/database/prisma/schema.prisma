generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  domains       OrganizationDomain[]
  orgUnits      OrgUnit[]
  users         User[]
}

model Organization {
  id        String   @id @default(cuid())
  tenantId  String
  code      String   @unique
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  domains  OrganizationDomain[]
  orgUnits OrgUnit[]
  users    User[]
  tickets  Ticket[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model OrganizationDomain {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  domain         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([tenantId, domain])
  @@index([tenantId])
  @@index([organizationId])
  @@index([tenantId, organizationId])
}

model OrgUnit {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  parentId       String?
  name           String
  managerName    String?
  description    String?
  email          String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  parent       OrgUnit?     @relation("OrgUnitTree", fields: [parentId], references: [id])
  children     OrgUnit[]    @relation("OrgUnitTree")
  requesters   User[]       @relation("RequesterOrgUnit")
  tickets      Ticket[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([parentId])
  @@index([tenantId, organizationId])
}

model User {
  id                 String   @id @default(cuid())
  name               String   @unique
  password           String
  role               String   @default("REQUESTER")
  mustResetPassword  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  orgUnitId String?
  orgUnit   OrgUnit? @relation("RequesterOrgUnit", fields: [orgUnitId], references: [id])

  assignedTickets Ticket[] @relation("AssignedTickets")
  createdTickets  Ticket[] @relation("CreatedTickets")
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  resolutionNotes String?
  completedAt DateTime?
  organizationId String
  orgUnitId   String
  createdById String
  assigneeId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  orgUnit      OrgUnit      @relation(fields: [orgUnitId], references: [id])
  assignee     User?        @relation("AssignedTickets", fields: [assigneeId], references: [id])
  createdBy    User         @relation("CreatedTickets", fields: [createdById], references: [id])
  attachments  TicketAttachment[]

  @@index([organizationId])
  @@index([orgUnitId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([status])
}

model TicketAttachment {
  id          String   @id @default(cuid())
  ticketId    String
  filename    String
  mimeType    String
  size        Int
  url         String
  createdAt   DateTime @default(now())

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

