{
  "name": "nyuro-ticket-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Nyuro Ticket System - Monorepo",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @nyuro/database db:generate",
    "db:migrate": "pnpm --filter @nyuro/database db:migrate",
    "db:studio": "pnpm --filter @nyuro/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
